{
  "redirects": [
    {
      "source": "/",
      "destination": "https://htdx.tad1.dev/content/"
    }, {
      "source": "/content/:path(.*)%20",
      "destination": "/content/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/content/:path",
      "headers":[
        {
          "key": "Link",
          "value" : "<https://htdx.tad1.dev/api/oembed/?url=https%3A%2F%2Fhtdx.tad1.dev%2Fcontent%2F:path>; rel=\"alternate\"; type=\"application/json+oembed\""
        }
      ]
    }
  ]
}